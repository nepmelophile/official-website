# ---------------------------------------------------------------------------
# Melophile environment variables
# Copy to .env.local for local development. In Vercel, set each of these for
# Production, Preview and Development (Project Settings → Environment Variables).
# Never commit real values.
# ---------------------------------------------------------------------------

# MongoDB connection string. Atlas in production; local docker-compose in dev:
#   docker compose up -d   →   mongodb://127.0.0.1:27018/melophile
# Use a SEPARATE database for Preview deployments so previews never touch prod data.
# If unset, the public site still builds and renders with empty/default content.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/melophile?retryWrites=true&w=majority

# Canonical site URL (no trailing slash) used for SEO, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin auth -------------------------------------------------------------
# Secret used to sign admin session JWTs (jose, HS256). At least 32 random chars:
#   openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters
# Single admin account credentials for /admin/login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Only when self-hosting (ignored on Vercel): how many reverse proxies in front of
# `next start` append to X-Forwarded-For (default 1). 0 = exposed directly, no proxy.
# Used to find the client IP for the login throttle and contact-form rate limit.
# TRUSTED_PROXY_HOPS=1

# --- ImageKit (media uploads) ----------------------------------------------
# From https://imagekit.io/dashboard/developer/api-keys. When unset, the admin
# image fields fall back to pasting an image URL.
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
# e.g. https://ik.imagekit.io/your_imagekit_id
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# --- Contact form email (Resend) -------------------------------------------
# When any of these are unset, messages are still saved to MongoDB (visible in
# /admin/messages) but no notification email is sent.
RESEND_API_KEY=
# Team inbox that receives contact-form notifications.
CONTACT_TO_EMAIL=
# Verified sender in Resend, e.g. "Melophile <noreply@melophilenp.com>".
CONTACT_FROM_EMAIL=
